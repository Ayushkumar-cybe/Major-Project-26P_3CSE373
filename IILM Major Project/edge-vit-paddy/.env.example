# ============================================================
# .env.example — Copy to .env and fill in real values
# NEVER commit .env to Git
# ============================================================

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=paddy_disease_db
DB_USER=paddy_user
DB_PASSWORD=your_secure_password_here

# Full DB URL (overrides individual fields above if set)
# DATABASE_URL=postgresql://paddy_user:your_password@localhost:5432/paddy_disease_db

# App
SECRET_KEY=change_this_to_a_random_secret
DEBUG=false

