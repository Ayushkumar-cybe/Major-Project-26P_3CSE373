# ============================================================
# .gitignore — Edge ViT Paddy Disease Detector
# ============================================================

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
*.egg-info/
dist/
build/
.eggs/

# ── Secrets ─────────────────────────────────────────────────
.env
*.pem
*.key

# ── Data (large files — use DVC or Kaggle API instead) ──────
data/raw/
data/processed/
data/train/
data/val/
data/augmented/
outputs/uploads/

# ── Model weights (large binaries) ──────────────────────────
models/*.onnx
models/*.pth
checkpoints/*.pth

# ── Outputs / Plots ─────────────────────────────────────────
outputs/plots/
outputs/logs/

# ── IDE / OS ────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
.DS_Store
Thumbs.db

# ── Jupyter ─────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Testing ─────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── Docker ──────────────────────────────────────────────────
*.env.docker

